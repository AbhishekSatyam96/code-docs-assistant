# Copy to `.env` and fill in. OPENAI_API_KEY and DATABASE_URL are required.

# ---- Required ---------------------------------------------------------------
OPENAI_API_KEY=sk-...

# Postgres with the pgvector extension (>= 0.8 for filtered-search recall).
# Neon, Supabase, RDS, or local — anything where `CREATE EXTENSION vector` works.
#
# In production use Neon's POOLED endpoint (host contains `-pooler`). The direct
# endpoint has a hard connection ceiling that N app instances will find; see the
# pool sizing note in src/lib/db/index.ts.
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require

# ---- Storage ----------------------------------------------------------------
# Everything is created inside its own schema, so this app can share a database
# with another project without either of them owning `public`.
# DATABASE_SCHEMA=code_docs

# ---- Models -----------------------------------------------------------------
# Defaults are chosen for availability rather than peak quality: gpt-4o and
# gpt-4o-mini work on every OpenAI account, so a fresh clone never fails with
# "model not found". If your account has access, gpt-4.1 is noticeably better
# at reading unfamiliar code.
# OPENAI_ANSWER_MODEL=gpt-4o
# OPENAI_UTILITY_MODEL=gpt-4o-mini

# Changing this invalidates every stored vector — embeddings from different
# models are not comparable — so the index is dropped and must be rebuilt.
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Point at an OpenAI-compatible gateway (Azure OpenAI, LiteLLM, vLLM, …).
# OPENAI_BASE_URL=https://api.openai.com/v1

# ---- Tests ------------------------------------------------------------------
# Integration tests run ONLY when this is set, and it is deliberately a separate
# variable from DATABASE_URL so a stray `npm test` can never reach a real index.
# Each run creates and drops its own randomly named schema.
# TEST_DATABASE_URL=postgresql://...

# ---- Optional ---------------------------------------------------------------
# Raises the GitHub rate limit (60/hr anonymous) and allows private repos.
# GITHUB_TOKEN=ghp_...

# debug | info | warn | error
# LOG_LEVEL=info
